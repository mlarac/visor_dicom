# Puerto en el que correrá el servidor Express
PORT=3000

# Configuración de Conexión a la Base de Datos SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=MiGlobal
DB_USER=visor
DB_PASSWORD=tu_password_aqui

# Clave secreta para firmar las cookies de sesión
SESSION_SECRET=cambia_esta_clave_secreta_en_produccion

# Configuración de Seguridad para la Cookie de Sesión (true para HTTPS, false para HTTP)
COOKIE_SECURE=false

# Entorno de ejecución (development o production)
NODE_ENV=production
