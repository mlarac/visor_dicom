<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Visualizador DICOM - Estudio #<%= studyId %></title>
  <link href="/vendor/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/vendor/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/viewer.css" rel="stylesheet">
</head>
<body>

  <div class="top-bar d-flex justify-content-between align-items-center p-2 px-4 shadow-sm">
    <div>
      <a href="/dashboard" class="btn btn-sm btn-outline-light rounded-pill me-3">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
      <span class="fw-medium text-light"><i class="bi bi-file-medical"></i> Estudio DICOM #<%= studyId %></span>
    </div>
    <div>
      <button id="btnWwwc" class="btn btn-sm btn-primary text-white border-secondary me-1" data-bs-toggle="tooltip" title="Ajustar Brillo/Contraste (WW/WC)"><i class="bi bi-brightness-half"></i></button>
      <button id="btnZoom" class="btn btn-sm btn-dark text-white border-secondary me-1" data-bs-toggle="tooltip" title="Zoom"><i class="bi bi-zoom-in"></i></button>
      <button id="btnPan" class="btn btn-sm btn-dark text-white border-secondary me-1" data-bs-toggle="tooltip" title="Mover"><i class="bi bi-arrows-move"></i></button>
      <button id="btnLength" class="btn btn-sm btn-dark text-white border-secondary me-3" data-bs-toggle="tooltip" title="Medir Longitud (Regla)"><i class="bi bi-rulers"></i></button>
      
      <button id="btnDownloadJpg" class="btn btn-sm btn-success text-white me-2" data-bs-toggle="tooltip" title="Descargar la imagen actual visualizada en formato JPG">
        <i class="bi bi-filetype-jpg"></i> Descargar JPG
      </button>

      <div class="btn-group">
        <button type="button" class="btn btn-sm btn-outline-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Descargar Estudio Completo">
          <i class="bi bi-download"></i> Descargar Todo
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
          <li>
            <a class="dropdown-item small" href="/dicom/descargar/<%= studyId %>">
              <i class="bi bi-file-earmark-zip me-2 text-primary"></i> DICOM (.zip)
            </a>
          </li>
          <li>
            <a class="dropdown-item small" href="/dicom/descargar-jpg/<%= studyId %>">
              <i class="bi bi-filetype-jpg me-2 text-success"></i> JPG (.zip)
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div id="mainContainer">
    <div class="sidebar">
      <!-- Metadatos de la serie activa -->
      <div class="sidebar-section" id="metadataSection">
        <div class="sidebar-section-title"><i class="bi bi-info-circle me-1"></i> Metadatos</div>
        <div id="dicomMetadata" class="text-secondary small">
          <p>Cargando información...</p>
        </div>
        <div id="seriesMetadata"></div>
      </div>

      <!-- Lista de Series -->
      <div id="seriesListContainer" class="sidebar-section">
        <div class="sidebar-section-title">
          <i class="bi bi-collection me-1"></i> Series (<span id="seriesCount">0</span>)
        </div>
        <div id="seriesListBody">
          <!-- Series cards dinámicas -->
        </div>
      </div>

      <!-- Thumbnails de la serie seleccionada -->
      <div id="thumbnailSection" class="sidebar-section">
        <div class="sidebar-section-title">
          <i class="bi bi-images me-1"></i> Imágenes (<span id="imageCount">0</span>)
        </div>
        <div id="thumbnailContainer">
          <!-- Thumbnails dinámicos -->
        </div>
      </div>
    </div>

    <div id="dicomImage" role="region" aria-label="Área de visualización DICOM" tabindex="0">
      <div class="text-secondary text-center" id="loaderInfo">
        <div class="spinner-border text-light mb-2" role="status"></div>
        <p>Cargando imágenes de la serie...</p>
      </div>
    </div>
  </div>

  <!-- Scripts de Bootstrap y Bundle Cornerstone3D -->
  <script src="/vendor/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/viewer-cornerstone3d.bundle.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Tooltips de Bootstrap
      const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
      tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });

      // 2. Iniciar Visor Cornerstone3D
      const serverSeries = <%- JSON.stringify(series || []) %>;
      window.initDicomViewer('<%= studyId %>', serverSeries);
    });
  </script>
</body>
</html>
